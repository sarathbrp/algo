# AlgoSphere Docker Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Ports (optional, defaults shown) ----
TIDB_PORT=4000
API_PORT=8000
FRONTEND_PORT=3080

# ---- API / Auth ----
JWT_SECRET=change-me-to-a-random-string

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=

# ---- Alpaca Broker (paper trading) ----
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# ---- Alpaca Broker (live trading, optional) ----
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
