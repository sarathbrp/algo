#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
  loop|paper)
    exec "$PY" scripts/run_alpaca_loop.py --paper "$@"
    ;;
  loop-live|live)
    exec "$PY" scripts/run_alpaca_loop.py --live "$@"
    ;;
  loop-v)
    exec "$PY" scripts/run_alpaca_loop.py --paper --verbose "$@"
    ;;
  api)
    exec "$PY" scripts/run_api.py "$@"
    ;;
  seed-users)
    exec "$PY" scripts/seed_users.py "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
AlgoSphere — algorithmic trading (see assets/algosphere-logo.svg)

Usage: ./bin/algo <command> [args passed through to the script]

  loop         run_alpaca_loop.py --paper
  loop-live    run_alpaca_loop.py --live
  loop-v       loop + --verbose
  api          run_api.py
  seed-users   seed_users.py

Or from repo root:  make loop-paper   |   make api   |   make test

Override Python:    PYTHON=python3.12 ./bin/algo loop
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    "$0" help
    exit 1
    ;;
esac
